# Copy to .env.local. Never commit .env.local.

# Run selection
E2E_ENV=dev
E2E_ENCRYPTION=true
E2E_LANG=en
PLATFORM=android
# local = Appium on this machine, browserstack = BrowserStack App Automate
E2E_TARGET=browserstack

# Existing Dev customer (must already be registered on Dev)
E2E_CUSTOMER_PHONE=
# Fixed/mock OTP for the Dev customer. Leave empty to fetch it from User/GetUserOtpDev.
E2E_CUSTOMER_OTP=
# Fixed Dev OTP accepted for unregistered numbers (sign-up cases). Defaults to E2E_CUSTOMER_OTP.
E2E_DEV_OTP=
# Backend-state seeds (see environment/testdata/seed.example.json). Default: environment/testdata/<env>/seed.json
E2E_SEED_FILE=

# Visual baselines for the "matches Figma" cases (baselines/<platform>/<lang>/<WxH>/<name>.png)
# Share of differing pixels allowed; strict = fail when no approved baseline exists; update = re-record all
VISUAL_DIFF_THRESHOLD=0.03
E2E_STRICT_VISUAL=0
E2E_UPDATE_BASELINES=0

# Local Appium (E2E_TARGET=local)
ANDROID_APP_PATH=
ANDROID_UDID=emulator-5554
IOS_APP_PATH=
IOS_UDID=

# Telegram run notifications (madark-automation-status channel).
# Leave token or chat id empty to skip sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Also post the summary when every test passes
TELEGRAM_NOTIFY_ON_SUCCESS=true
# Max failure screenshots sent per run
TELEGRAM_MAX_SCREENSHOTS=10

# BrowserStack (E2E_TARGET=browserstack)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_APP_URL=
BROWSERSTACK_APP_URL_IOS=
DEVICE_NAME=Samsung Galaxy S23
OS_VERSION=13.0
IOS_DEVICE_NAME=iPhone 16
IOS_OS_VERSION=18
BUILD_NAME=madark-e2e

# App source to scan. `npm run snapshot` exports APP_REF from APP_REPO (read-only, git archive).
APP_REPO=D:/Madark Project/Mobile runner/repos/Madarak-UserApp/Madarak-UserApp
APP_REF=origin/new_design_kinan
# Leave empty to use the snapshot; set to a Flutter folder (with pubspec.yaml) to scan that instead
APP_ROOT=
# Regression cases exported from Azure DevOps (default: data/ado/mobile_regression_cases.json)
SUITE_SOURCE=
