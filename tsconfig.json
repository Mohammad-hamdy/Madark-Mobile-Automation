{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@madark/pages/*": ["pages/*"],
      "@madark/utils/*": ["utils/*"],
      "@madark/fixtures/*": ["fixtures/*"],
      "@madark/api/*": ["api/*"],
      "@madark/environment": ["environment/index.ts"],
      "@madark/environment/*": ["environment/*"],
      "@madark/i18n/*": ["i18n/*"],
      "@madark/config/capabilities": ["config/capabilities/index.ts"],
      "@madark/config/*": ["config/*"],
      "@madark/generated/*": ["generated/*"],
      "@madark/*": ["./*"]
    },
    "types": ["node", "mocha", "@wdio/globals/types", "@wdio/mocha-framework"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "allure-results", "allure-report"]
}
