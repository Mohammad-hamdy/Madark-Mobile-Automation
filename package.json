{
  "name": "madark-mobile-e2e",
  "private": true,
  "scripts": {
    "appium": "appium --address 127.0.0.1 --port 4725 --relaxed-security --allow-insecure=uiautomator2:adb_shell",
    "appium:install-drivers": "appium driver install uiautomator2 && appium driver install xcuitest",
    "snapshot": "tsx scripts/snapshot-app.ts",
    "scan": "tsx scripts/scan-app.ts",
    "import:suite": "tsx scripts/import-suite.ts",
    "generate": "npm run snapshot && npm run scan && npm run import:suite && npm run verify:locators",
    "testdata:generate": "tsx environment/testdata/helpers/generate-testdata.ts",
    "verify:locators": "tsx scripts/verify-locators.ts",
    "verify:crypto": "tsx scripts/verify-crypto.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "typecheck": "tsc --noEmit",
    "test": "wdio run wdio.conf.ts",
    "test:android": "cross-env PLATFORM=android wdio run wdio.conf.ts",
    "test:ios": "cross-env PLATFORM=ios wdio run wdio.conf.ts",
    "test:smoke": "cross-env E2E_TAGS=smoke wdio run wdio.conf.ts",
    "test:bs": "cross-env E2E_TARGET=browserstack wdio run wdio.conf.ts",
    "test:bs:smoke": "cross-env E2E_TARGET=browserstack E2E_TAGS=smoke wdio run wdio.conf.ts",
    "allure:report": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@wdio/allure-reporter": "^8.43.0",
    "@wdio/cli": "^8.43.0",
    "@wdio/globals": "^8.43.0",
    "@wdio/local-runner": "^8.43.0",
    "@wdio/mocha-framework": "^8.43.0",
    "@wdio/spec-reporter": "^8.43.0",
    "@wdio/types": "^8.41.0",
    "allure-commandline": "^2.32.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
